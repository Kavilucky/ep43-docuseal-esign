# Скопируйте в .env и заполните. Файл .env не публикуйте и не коммитьте.
# Домен с A-записью на IP сервера (порты 80 и 443 открыты)
HOST=sign.example.com
# Пароль базы: длинная случайная строка без пробелов и спецсимволов @:/?#
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ
# Ключи шифрования: сгенерируйте ОДИН РАЗ (openssl rand -hex 64) и никогда не меняйте после запуска:
# по руководствам по самохостингу ими шифруется ключ центра подписи; при смене подписи нельзя будет проверить.
# Сделайте копию .env отдельно от сервера (правило 3-2-1).
SECRET_KEY_BASE=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_128_СИМВОЛОВ
ENCRYPTION_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_128_СИМВОЛОВ
